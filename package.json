{
  "name": "pineapple-games-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tests del sitio Pineapple Games (https://pineappleva.github.io/Games/)",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:static": "node --test \"tests/static/*.test.mjs\"",
    "test:runtime": "node --test \"tests/runtime/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test:live": "PG_LIVE=1 node --test \"tests/live/*.test.mjs\"",
    "test:all": "PG_LIVE=1 node --test \"tests/**/*.test.mjs\"",
    "serve": "node tests/helpers/serve.mjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "parse5": "^8.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
